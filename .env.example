# Copy to .env.local for dev. In production, set these in Vercel → Settings → Environment Variables (mark Sensitive).
APP_USERNAME=reviewer
# node scripts/hash-password.mjs '<password>'
APP_PASSWORD_HASH=
# openssl rand -base64 32   (rotate to log everyone out)
SESSION_SECRET=
ANTHROPIC_API_KEY=
# Optional. Unset = claude-opus-5-5 (D51). Dev may use claude-haiku-4-5 (D81). Never set in production.
ROUND_MODEL=
# Optional. Unset = claude-sonnet-5-5 (D97, picked by the M2 mini-eval). Only an evaluated candidate is accepted.
GRADE_MODEL=
# Optional, dev only. 1 = /api/round and /api/grade replay recorded rounds and grades instead of calling Claude (M3).
# Dev commands: /plain, /truncated, /empty. Ignored on the production deployment.
USE_FIXTURES=
